// HDS-style polymorphic-tag wrapper using `(element X)`. The
// runtime tag is whatever `this.componentTag` resolves to.
import Component from '@glimmer/component';

interface PolyTextSig {
  Element: HTMLSpanElement | HTMLHeadingElement | HTMLParagraphElement;
  Args: { tag?: string };
  Blocks: { default: [] };
}

export default class PolyText extends Component<PolyTextSig> {
  get componentTag(): string {
    const { tag = 'span' } = this.args;
    return tag;
  }
  <template>
    {{#let (element this.componentTag) as |Tag|}}<Tag ...attributes>{{yield}}</Tag>{{/let}}
  </template>
}
