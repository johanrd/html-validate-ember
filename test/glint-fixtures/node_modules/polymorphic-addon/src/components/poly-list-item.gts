// Wraps PolyText with literal `@tag="li"`. Runtime tag: `<li>`.
// The chain trace propagates the literal up: PolyText is
// polymorphic-on-`@tag`, this wrapper passes `@tag="li"` →
// resolves to `{ kind: 'tag', tag: 'li' }`.
import type { TemplateOnlyComponent } from '@ember/component/template-only';
import PolyText from './poly-text.gts';

interface PolyListItemSig {
  Element: HTMLLIElement;
  Blocks: { default: [] };
}

const PolyListItem: TemplateOnlyComponent<PolyListItemSig> = <template>
  <PolyText @tag="li" ...attributes>{{yield}}</PolyText>
</template>;

export default PolyListItem;
