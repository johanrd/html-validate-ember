import Component from '@glimmer/component';

export interface PolymorphicCardSignature {
  Args: { tag?: 'div' | 'li' | 'section' };
  Blocks: { default: [] };
  Element: HTMLElement;
}

// Polymorphic-tag component pattern: renders a different native element
// depending on a `@tag` arg. The class getter reads `this.args.tag` and
// falls back to `'div'`. The template uses an if-else to pick between a
// literal `<div>` and `{{#let (element this.componentTag) as |Tag|}}` for
// the non-default case. This is the pattern found in HDS card/container and
// similar polymorphic-element addon components.
export default class PolymorphicCard extends Component<PolymorphicCardSignature> {
  get componentTag(): 'div' | 'li' | 'section' {
    const { tag = 'div' } = this.args;
    return tag;
  }

  <template>
    {{#if (eq this.componentTag "div")}}
      <div ...attributes>{{yield}}</div>
    {{else}}
      {{#let (element this.componentTag) as |Tag|}}
        <Tag ...attributes>{{yield}}</Tag>
      {{/let}}
    {{/if}}
  </template>
}
