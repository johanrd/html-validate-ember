{
  "$schema-comment": "Pinned snapshots of public Ember repos that the plugin runs against in ecosystem CI. SHAs are bumped manually for now (a periodic bump workflow can come later). The `include` glob patterns use a small minimatch subset (`**`, `*`, `?`, `{a,b}`) and are evaluated against repo-relative paths; `exclude` is applied first so noise like fixtures, generated dist trees, and node_modules never reaches html-validate. Layouts were verified at the pinned SHAs — when bumping, re-probe the repo if `files: 0` shows up.",
  "targets": [
    {
      "name": "super-rentals",
      "repo": "ember-learn/super-rentals",
      "ref": "3d0480f066b27b8410136a858320a47671affbe3",
      "include": ["app/**/*.{gts,gjs,hbs}"],
      "exclude": []
    },
    {
      "name": "ember-website",
      "repo": "ember-learn/ember-website",
      "ref": "43ac579887f0722e0dc321392ecbab0affb49f34",
      "include": ["app/**/*.{gts,gjs,hbs}"],
      "exclude": []
    },
    {
      "name": "ember-power-select",
      "repo": "cibernox/ember-power-select",
      "ref": "bf21b6c08ff87c1921f9fb19d200f994fdfea28c",
      "include": [
        "src/**/*.{gts,gjs,hbs}",
        "demo-app/**/*.{gts,gjs,hbs}",
        "docs/app/**/*.{gts,gjs,hbs}"
      ],
      "exclude": []
    },
    {
      "name": "ember-modifier",
      "repo": "ember-modifier/ember-modifier",
      "ref": "deb8359e2e1c35b0a1166969b25110de3a473eb5",
      "include": ["test-app/**/*.{gts,gjs,hbs}"],
      "exclude": []
    },
    {
      "name": "ember-simple-auth",
      "repo": "mainmatter/ember-simple-auth",
      "ref": "27bd323f4c7f35e8aa19e770f095b06b839ca479",
      "include": ["packages/test-app/**/*.{gts,gjs,hbs}"],
      "exclude": []
    },
    {
      "name": "hds-design-system",
      "repo": "hashicorp/design-system",
      "ref": "9db0ff66136c04789d756d7b1454f3e48fc635ae",
      "include": [
        "packages/components/src/**/*.{gts,gjs,hbs}",
        "showcase/app/**/*.{gts,gjs,hbs}",
        "website/app/**/*.{gts,gjs,hbs}"
      ],
      "exclude": [],
      "build": [
        ["pnpm", "--filter", "@hashicorp/design-system-components", "build"]
      ]
    },
    {
      "name": "ember-primitives",
      "repo": "universal-ember/ember-primitives",
      "ref": "b8a890e912e74a0241dbb321ca8750c9b7ce3ffb",
      "include": [
        "ember-primitives/src/**/*.{gts,gjs,hbs}",
        "docs-app/app/**/*.{gts,gjs,hbs}",
        "test-app/app/**/*.{gts,gjs,hbs}"
      ],
      "exclude": []
    },
    {
      "name": "limber",
      "repo": "NullVoxPopuli/limber",
      "ref": "b7d73e54c33e2dc51f1a778985851b82dcada431",
      "include": [
        "apps/repl/app/**/*.{gts,gjs,hbs}",
        "apps/tutorial/app/**/*.{gts,gjs,hbs}",
        "packages/ember-repl/src/**/*.{gts,gjs,hbs}",
        "packages/limber-ui/src/**/*.{gts,gjs,hbs}",
        "packages/app-support/shared/src/**/*.{gts,gjs,hbs}"
      ],
      "exclude": []
    },
    {
      "name": "ember-concurrency",
      "repo": "machty/ember-concurrency",
      "ref": "fc7e0463313b2336956e7e6e64fa433d714bef1b",
      "include": ["packages/test-app/app/**/*.{gts,gjs,hbs}"],
      "exclude": []
    },
    {
      "name": "vertical-collection",
      "repo": "html-next/vertical-collection",
      "ref": "f01c770f1dde915394651eb2a0635df6ae77e9cc",
      "include": [
        "vertical-collection/src/**/*.{gts,gjs,hbs}",
        "test-app/app/**/*.{gts,gjs,hbs}"
      ],
      "exclude": []
    },
    {
      "name": "cardstack-ui-components",
      "repo": "cardstack/ui-components",
      "ref": "589ad84bdf3afe4f35628f70497d720b9a89c193",
      "include": [
        "app/templates/**/*.{gts,gjs,hbs}",
        "tests/dummy/app/**/*.{gts,gjs,hbs}"
      ],
      "exclude": []
    },
    {
      "name": "discourse",
      "repo": "discourse/discourse",
      "ref": "d8aadf144c22e64d7415144839f60538d54aa440",
      "$comment": "Discourse is a Rails app embedding Ember in `frontend/discourse/`. Most templates are classic .hbs (no Signatures), so Glint adds little value here — and `pnpm install` on the full repo is heavy. Disable Glint to keep ecosystem CI fast; lint catches plenty of real-world structural issues even without it.",
      "glint": false,
      "include": [
        "frontend/discourse/app/**/*.{gts,gjs,hbs}",
        "frontend/discourse/admin/**/*.{gts,gjs,hbs}",
        "frontend/discourse/select-kit/**/*.{gts,gjs,hbs}"
      ],
      "exclude": ["**/tests/**"]
    }
  ]
}
